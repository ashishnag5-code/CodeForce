<apex:page applyHtmlTag="false" renderAs="pdf"  showHeader="false" standardstylesheets="true" applyBodyTag="false"
    controller="SystemGeneratedEsignDocumentsController">
    <apex:variable value="{!1}" var="rowNumForSOC"/>
    <apex:variable value="{!1}" var="rowNumForInterest"/>

    <html>
    <head>
        <style type="text/CSS">
            @page {
                    margin: 0.1in;
                	size: 12in 12in;
                    margin-bottom: 70px;
                    margin-top: 50px;
                }
        </style>
            <!--
            .tabledata{
                    width:30% !important;
                    border: 1px solid white !important;
                }
                .tabledataColon{
                    width:5% !important;
                    border: 1px solid white !important;
                }
                .tabledataValue{ 
                    width:65% !important;
                    border: 1px solid white !important;
                }
                table {
                    page-break-inside: avoid;
                }
            </style>-->
    </head>

    <body>
        <apex:variable value="{!0}" var="rowNum" />

        <div style="text-align:center;font-weight:bold;font-size:16px;font-family:Arial;">
            <span style="display:inline-block; border-bottom:0.1em solid black; padding: 0.5px">AU SMALL FINANCE
                BANK
                LIMITED ("AUSFB") - Sanction Letter</span>
        </div>
        <br />
        <br />
        <table style="text-align:left;font-weight:normal;font-size:14px;font-family:Arial;padding: 0.1em">
            <tr>
                <td class="tabledata">Ref No</td>
                <td class="tabledataColon">:&nbsp;</td>
                <td class="tabledataValue"><span
                        style="display:inline-block; border-bottom:0.05em solid black; padding: 0.5px">{!loan.Application_Id__c}</span>
                </td>
            </tr>
            <tr>
                <td class="tabledata">Date</td>
                <td class="tabledataColon">:&nbsp;</td>
                <td class="tabledata"><span
                        style="display:inline-block; border-bottom:0.05em solid black; padding: 0.5px">{!todaysDate}</span>
                </td>
            </tr>
            <tr>
                <td class="tabledata">Kind Attn: </td>
                <td class="tabledataColon">:&nbsp;</td>
                <td class="tabledata"><span
                        style="display:inline-block; border-bottom:0.05em solid black; padding: 0.5px">{!applicant.Title__c} {!applicant.First_Name__c}
                        {!applicant.Middle_Name__c} {!applicant.Last_Name__c}</span></td>
            </tr>
        </table>
        <br />
        <div style="text-align:left;font-weight:normal;font-size:14px;font-family:Arial;padding: 0.1em">
            Subject : Sanction of
            <span
                style="display:inline-block; border-bottom:0.05em solid black; padding: 0.5px">{!productRT.MasterLabel}</span>
            loan from AU Small Finance Bank Limited for an amount of Rs.
            <span
                style="display:inline-block; border-bottom:0.05em solid black; padding: 0.5px">
                    <apex:outputField value="{!loan.Total_Loan_Amount__c}"/>
                </span>
            /- only.
        </div>
        <br />
        <div style="text-align:left;font-weight:normal;font-size:14px;font-family:Arial;padding: 0.1em">
            Dear Sir/Madam,
        </div>
        <br />
        <div style="text-align:left;font-weight:normal;font-size:14px;font-family:Arial;padding: 0.1em">
            We thank you for choosing AU SMALL FINANCE BANK LIMITED ("<b>AUSFB</b>" <i>which expression shall
                include
                our successors, transferers, novatees and assigns</i>) as your financial partner and look forward to
            an
            enduring relationship with you.
        </div>
        <br />
        <div style="text-align:left;font-weight:normal;font-size:14px;font-family:Arial;padding: 0.1em">
            With reference to your loan application (“Application”), we are pleased to extend to you the captioned
            loan
            for an amount detailed below subject to terms and conditions set out in this letter (“<b>Sanction
                Letter</b>”) and execution of the loan documents between you, i.e. the “<b>Borrower</b>” and AUSFB
            and
            submission of other required documents detailed below.
        </div>
        <br />
        <br />
        <div style="text-align:center;font-weight:bold;font-size:14px;font-family:Arial;">
            <span style="display:inline-block; border-bottom:0.1em solid black; padding: 0.5px">TERMS OF
                SANCTION/KEY
                FACT STATEMENT (KFS)</span>
        </div>
        <br />
        <div style="text-align:left;font-weight:normal;font-size:14px;font-family:Arial;padding: 0.1em">
            This Sanction Letter/KFS shall be read, understood, and construed in conjunction with the terms
            contained
            here-in and those as contained in the Agreement for Loan cum Hypothecation and the Loan Application made
            and
            signed by the Borrower/Co-Borrower/Guarantor named herein:
        </div>
        <br />
        <div style="text-align:left;font-weight:normal;font-size:14px;font-family:Arial;padding: 0.1em">
            <table style="border: 0.1em solid black; border-collapse: collapse;">
                <tr>
                    <th style="padding: 0.5em; border: 0.1em solid black;">Sr. No.</th>
                    <th style="padding: 0.5em; border: 0.1em solid black;">Particulars</th>
                    <th style="padding: 0.5em; border: 0.1em solid black;">Details/Description</th>
                </tr>
                <tr>
                    <td style="padding: 0.5em; border: 0.1em solid black;">1.</td>
                    <td style="padding: 0.5em; border: 0.1em solid black;">Application</td>
                    <td style="padding: 0.5em; border: 0.1em solid black;">
                        <table style="width:100%">
                            <tr width="100%">
                                <td class="tabledata" width="30%">Application Form No</td>
                                <td class="tabledataColon" width="5%">:&nbsp;</td>
                                <td class="tabledataValue" width="65%">{!loan.Application_Id__c}</td>
                            </tr>
                            <tr>
                                <td class="tabledata">Application Form Date</td>
                                <td class="tabledataColon">:&nbsp;</td>
                                <td class="tabledataValue">{!createdDate}</td>
                            </tr>
                        </table>
                    </td>

                </tr>
                <tr>
                    <td style="padding: 0.5em; border: 0.1em solid black;">2.</td>
                    <td style="padding: 0.5em; border: 0.1em solid black;">Borrower</td>
                    <td style="padding: 0.5em; border: 0.1em solid black;">
                        <table style="width:100%">
                            <tr width="100%">
                                <td class="tabledata" width="30%">Name</td>
                                <td class="tabledataColon" width="5%">:&nbsp;</td>
                                <td class="tabledataValue" width="65%">{!applicant.First_Name__c} {!applicant.Middle_Name__c}
                                    {!applicant.Last_Name__c}</td>
                            </tr>
                            <tr style="">
                                <td class="tabledata">Father/Husband&apos;s Name</td>
                                <td class="tabledataColon">:&nbsp;</td>
                                <td class="tabledataValue">
                                    <apex:outputPanel rendered="{!applicant.Gender__c = 'Female'}">
                                        <apex:outputPanel rendered="{!applicant.Marital_Status__c = 'Married'}">
                                            {!applicant.Spouse_Name__c}
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!applicant.Marital_Status__c <> 'Married'}">
                                            {!applicant.Father_Name__c}
                                        </apex:outputPanel>
                                    </apex:outputPanel>
                                    <apex:outputPanel rendered="{!applicant.Gender__c <> 'Female'}">
                                        {!applicant.Father_Name__c}
                                    </apex:outputPanel>
                                </td>
                            </tr>
                            <tr style="">
                                <td class="tabledata">Current Address</td>
                                <td class="tabledataColon">:&nbsp;</td>
                                <td class="tabledataValue">
                                    {!addressMap[applicant.Id]['Current'].Address_Line_1__c},&nbsp;
                                    <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[applicant.Id]['Current'].Address_Line_2__c))}">
                                        {!addressMap[applicant.Id]['Current'].Address_Line_2__c},&nbsp;
                                    </apex:outputPanel>
                                    <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[applicant.Id]['Current'].Address_Line_3__c))}">
                                        {!addressMap[applicant.Id]['Current'].Address_Line_3__c},&nbsp;
                                    </apex:outputPanel>
                                    <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[applicant.Id]['Current'].City__c))}">
                                        {!addressMap[applicant.Id]['Current'].City__c},&nbsp;
                                    </apex:outputPanel>
                                    <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[applicant.Id]['Current'].State__c))}">
                                        {!addressMap[applicant.Id]['Current'].State__c},&nbsp;
                                    </apex:outputPanel>
                                    <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[applicant.Id]['Current'].PinCode__c))}">
                                        {!addressMap[applicant.Id]['Current'].PinCode__c}
                                    </apex:outputPanel>
                                    
                                </td>
                            </tr>
                            <apex:outputText rendered="{!OR(AND(applicant.Customer_Type__c == 'Non Individual', NOT(ISBLANK(addressMap[applicant.Id]['Permanent'].Address_Line_1__c))), applicant.Customer_Type__c <> 'Non Individual')}">
                                <tr style="">
                                    <td class="tabledata">Permanent Address</td>
                                    <td class="tabledataColon">:&nbsp;</td>
                                    <td class="tabledataValue">
                                        {!addressMap[applicant.Id]['Permanent'].Address_Line_1__c},&nbsp;
                                        <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[applicant.Id]['Permanent'].Address_Line_2__c))}">
                                            {!addressMap[applicant.Id]['Permanent'].Address_Line_2__c},&nbsp;
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[applicant.Id]['Permanent'].Address_Line_3__c))}">
                                            {!addressMap[applicant.Id]['Permanent'].Address_Line_3__c},&nbsp;
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[applicant.Id]['Permanent'].City__c))}">
                                            {!addressMap[applicant.Id]['Permanent'].City__c},&nbsp;
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[applicant.Id]['Permanent'].State__c))}">
                                            {!addressMap[applicant.Id]['Permanent'].State__c},&nbsp;
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[applicant.Id]['Permanent'].PinCode__c))}">
                                            {!addressMap[applicant.Id]['Permanent'].PinCode__c}
                                        </apex:outputPanel>
                                        
                                    </td>
                                </tr>
                            </apex:outputText>
                            <tr style="">
                                <td class="tabledata">PAN</td>
                                <td class="tabledataColon">:&nbsp;</td>
                                <td class="tabledataValue">
                                    {!applicant.PAN__c}
                                </td>
                            </tr>
                            <tr style="">
                                <td class="tabledata">Mobile Number</td>
                                <td class="tabledataColon">:&nbsp;</td>
                                <td class="tabledataValue">
                                    {!applicant.Mobile_Number__c}
                                </td>
                            </tr>
                            <tr style="">
                                <td class="tabledata">Email ID</td>
                                <td class="tabledataColon">:&nbsp;</td>
                                <td class="tabledataValue">
                                    {!applicant.Email__c}
                                </td>
                            </tr>
                            <tr style="">
                                <td class="tabledata">Office Address</td>
                                <td class="tabledataColon">:&nbsp;</td>
                                <td class="tabledataValue">
                                    {!addressMap[applicant.Id]['Office'].Address_Line_1__c},&nbsp;
                                    <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[applicant.Id]['Office'].Address_Line_2__c))}">
                                        {!addressMap[applicant.Id]['Office'].Address_Line_2__c},&nbsp;
                                    </apex:outputPanel>
                                    <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[applicant.Id]['Office'].Address_Line_3__c))}">
                                        {!addressMap[applicant.Id]['Office'].Address_Line_3__c},&nbsp;
                                    </apex:outputPanel>
                                    <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[applicant.Id]['Office'].City__c))}">
                                        {!addressMap[applicant.Id]['Office'].City__c},&nbsp;
                                    </apex:outputPanel>
                                    <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[applicant.Id]['Office'].State__c))}">
                                        {!addressMap[applicant.Id]['Office'].State__c},&nbsp;
                                    </apex:outputPanel>
                                    <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[applicant.Id]['Office'].PinCode__c))}">
                                        {!addressMap[applicant.Id]['Office'].PinCode__c}
                                    </apex:outputPanel>    
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td style="padding: 0.5em; border: 0.1em solid black;">3.</td>
                    <td style="padding: 0.5em; border: 0.1em solid black;">Co-Borrower</td>
                    <td style="padding: 0.5em; border: 0.1em solid black;">
                        <apex:variable value="{!1}" var="rowNum"/>
                        <apex:repeat value="{!coapplicants}" var="coapplicant">
                            <table style="table-layout:fixed;padding-bottom: 0.5em; padding-right: 0.5em; padding-top: 0.5em;">
                                <tr width="100%">
                                    <td class="tabledata" width="30%">Name</td>
                                    <td class="tabledataColon" width="5%">:&nbsp;</td>
                                    <td class="tabledataValue" width="65%">{!coapplicant.First_Name__c}
                                        {!coapplicant.Middle_Name__c} {!coapplicant.Last_Name__c}
                                    </td>
                                </tr>
                                <tr style="">
                                    <td class="tabledata">Father/Husband&apos;s Name</td>
                                    <td class="tabledataColon">:&nbsp;</td>
                                    <td class="tabledataValue">
                                        <apex:outputPanel rendered="{!coapplicant.Gender__c = 'Female'}">
                                            <apex:outputPanel rendered="{!coapplicant.Marital_Status__c = 'Married'}">
                                                {!coapplicant.Spouse_Name__c}
                                            </apex:outputPanel>
                                            <apex:outputPanel rendered="{!coapplicant.Marital_Status__c <> 'Married'}">
                                                {!coapplicant.Father_Name__c}
                                            </apex:outputPanel>
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!coapplicant.Gender__c <> 'Female'}">
                                            {!coapplicant.Father_Name__c}
                                        </apex:outputPanel>
                                    </td>
                                </tr>
                                <tr style="">
                                    <td class="tabledata">Current Address</td>
                                    <td class="tabledataColon">:&nbsp;</td>
                                    <td class="tabledataValue">
                                        {!addressMap[coapplicant.Id]['Current'].Address_Line_1__c},&nbsp;
                                        <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[coapplicant.Id]['Current'].Address_Line_2__c))}">
                                            {!addressMap[coapplicant.Id]['Current'].Address_Line_2__c},&nbsp;
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[coapplicant.Id]['Current'].Address_Line_3__c))}">
                                            {!addressMap[coapplicant.Id]['Current'].Address_Line_3__c},&nbsp;
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[coapplicant.Id]['Current'].City__c))}">
                                            {!addressMap[coapplicant.Id]['Current'].City__c},&nbsp;
                                        </apex:outputPanel>
                                        {!addressMap[coapplicant.Id]['Current'].State__c},&nbsp;
                                        {!addressMap[coapplicant.Id]['Current'].PinCode__c}
                                    </td>
                                </tr>
                                <tr style="">
                                    <td class="tabledata">Permanent Address</td>
                                    <td class="tabledataColon">:&nbsp;</td>
                                    <td class="tabledataValue">
                                        {!addressMap[coapplicant.Id]['Permanent'].Address_Line_1__c},&nbsp;
                                        <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[coapplicant.Id]['Permanent'].Address_Line_2__c))}">
                                            {!addressMap[coapplicant.Id]['Permanent'].Address_Line_2__c},&nbsp;
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[coapplicant.Id]['Permanent'].Address_Line_3__c))}">
                                            {!addressMap[coapplicant.Id]['Permanent'].Address_Line_3__c},&nbsp;
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[coapplicant.Id]['Permanent'].City__c))}">
                                            {!addressMap[coapplicant.Id]['Permanent'].City__c},&nbsp;
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[coapplicant.Id]['Permanent'].State__c))}">
                                            {!addressMap[coapplicant.Id]['Permanent'].State__c},&nbsp;
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[coapplicant.Id]['Permanent'].PinCode__c))}">
                                            {!addressMap[coapplicant.Id]['Permanent'].PinCode__c}
                                        </apex:outputPanel>
                                    </td>
                                </tr>
                                <tr style="">
                                    <td class="tabledata">PAN</td>
                                    <td class="tabledataColon">:&nbsp;</td>
                                    <td class="tabledataValue">
                                        {!coapplicant.PAN__c}
                                    </td>
                                </tr>
                                <tr style="">
                                    <td class="tabledata">Mobile Number</td>
                                    <td class="tabledataColon">:&nbsp;</td>
                                    <td class="tabledataValue">
                                        {!coapplicant.Mobile_Number__c}
                                    </td>
                                </tr>
                                <tr style="">
                                    <td class="tabledata">Email ID</td>
                                    <td class="tabledataColon">:&nbsp;</td>
                                    <td class="tabledataValue">
                                        {!coapplicant.Email__c}
                                    </td>
                                </tr>
                                <tr style="">
                                    <td class="tabledata">Office Address</td>
                                    <td class="tabledataColon">:&nbsp;</td>
                                    <td class="tabledataValue">
                                        {!addressMap[coapplicant.Id]['Office'].Address_Line_1__c},&nbsp;
                                        <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[coapplicant.Id]['Office'].Address_Line_2__c))}">
                                            {!addressMap[coapplicant.Id]['Office'].Address_Line_2__c},&nbsp;
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[coapplicant.Id]['Office'].Address_Line_3__c))}">
                                            {!addressMap[coapplicant.Id]['Office'].Address_Line_3__c},&nbsp;
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[coapplicant.Id]['Office'].City__c))}">
                                            {!addressMap[coapplicant.Id]['Office'].City__c},&nbsp;
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[coapplicant.Id]['Office'].State__c))}">
                                            {!addressMap[coapplicant.Id]['Office'].State__c},&nbsp;
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[coapplicant.Id]['Office'].PinCode__c))}">
                                            {!addressMap[coapplicant.Id]['Office'].PinCode__c}
                                        </apex:outputPanel>
                                    </td>
                                </tr>
                            </table>
                            <apex:outputPanel rendered="{!rowNum < coapplicants.size}"><hr/></apex:outputPanel>
                            <apex:variable var="rowNum" value="{!rowNum + 1}"/>
                        </apex:repeat>
                    </td>
                </tr>
                <tr>
                    <td style="padding: 0.5em; border: 0.1em solid black;">4.</td>
                    <td style="padding: 0.5em; border: 0.1em solid black;">Repayment Account</td>
                    <td style="padding: 0.5em; border: 0.1em solid black;">
                        <table style="width:100%">
                            <tr width="100%">
                                <td class="tabledata" width="30%">Account Holder Name</td>
                                <td class="tabledataColon" width="5%">:&nbsp;</td>
                                <td class="tabledataValue" width="65%">{!loan.Repayment_By__c}</td>
                            </tr>
                            <tr>
                                <td class="tabledata">Account No</td>
                                <td class="tabledataColon">:&nbsp;</td>
                                <td class="tabledataValue">{!loan.Repayment_Account_Number__c}</td>
                            </tr>
                            <tr>
                                <td class="tabledata">Bank Name</td>
                                <td class="tabledataColon">:&nbsp;</td>
                                <td class="tabledataValue">{!loan.Repayment_Bank_Name__c}</td>
                            </tr>
                            <tr>
                                <td class="tabledata">IFSC</td>
                                <td class="tabledataColon">:&nbsp;</td>
                                <td class="tabledataValue">{!loan.IFSC_Code__c}</td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td style="padding: 0.5em; border: 0.1em solid black;">5.</td>
                    <td style="padding: 0.5em; border: 0.1em solid black;">Lender</td>
                    <td style="padding: 0.5em; border: 0.1em solid black;">
                        <table style="table-layout:fixed; width:100%">
                            <tr width="100%">
                                <td class="tabledata" width="30%">Name</td>
                                <td class="tabledataColon" width="5%">:&nbsp;</td>
                                <td class="tabledataValue" width="65%">AU SMALL FINANCE BANK LIMITED</td>
                            </tr>
                            <tr>
                                <td class="tabledata">Branch</td>
                                <td class="tabledataColon">:&nbsp;</td>
                                <td class="tabledataValue">
                                    {!loan.Branch_Master__r.Account_Name__c}
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td style="padding: 0.5em; border: 0.1em solid black;">6.</td>
                    <td style="padding: 0.5em; border: 0.1em solid black;">Guarantor (if any)</td>
                    <td style="padding: 0.5em; border: 0.1em solid black;">
                        <apex:variable value="{!1}" var="rowNum"/>
                        <apex:repeat value="{!guarantors}" var="guarantor">
                            <table style="table-layout:fixed;padding-bottom: 0.5em; padding-right: 0.5em; padding-top: 0.5em;">
                                <tr width="100%">
                                    <td class="tabledata" width="30%">Name</td>
                                    <td class="tabledataColon" width="5%">:&nbsp;</td>
                                    <td class="tabledataValue" width="65%">{!guarantor.First_Name__c}
                                        {!guarantor.Middle_Name__c} {!guarantor.Last_Name__c}
                                    </td>
                                </tr>
                                <tr style="">
                                    <td class="tabledata">Father/Husband&apos;s Name</td>
                                    <td class="tabledataColon">:&nbsp;</td>
                                    <td class="tabledataValue">
                                        <apex:outputPanel rendered="{!guarantor.Gender__c = 'Female'}">
                                            <apex:outputPanel rendered="{!guarantor.Marital_Status__c = 'Married'}">
                                                {!guarantor.Spouse_Name__c}
                                            </apex:outputPanel>
                                            <apex:outputPanel rendered="{!guarantor.Marital_Status__c <> 'Married'}">
                                                {!guarantor.Father_Name__c}
                                            </apex:outputPanel>
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!guarantor.Gender__c <> 'Female'}">
                                            {!guarantor.Father_Name__c}
                                        </apex:outputPanel>
                                    </td>
                                </tr>
                                <tr style="">
                                    <td class="tabledata">Current Address</td>
                                    <td class="tabledataColon">:&nbsp;</td>
                                    <td class="tabledataValue">
                                        {!addressMap[guarantor.Id]['Current'].Address_Line_1__c},&nbsp;
                                        <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[guarantor.Id]['Current'].Address_Line_2__c))}">
                                            {!addressMap[guarantor.Id]['Current'].Address_Line_2__c},&nbsp;
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[guarantor.Id]['Current'].Address_Line_3__c))}">
                                            {!addressMap[guarantor.Id]['Current'].Address_Line_3__c},&nbsp;
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!NOT(ISBLANK(addressMap[guarantor.Id]['Current'].City__c))}">
                                            {!addressMap[guarantor.Id]['Current'].City__c},&nbsp;
                                        </apex:outputPanel>
