<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,force:hasSObjectName,forceCommunity:availableForAllPageTypes,force:lightningQuickAction,lightning:actionOverride,lightning:isUrlAddressable" access="global" >
    <aura:attribute name="recordId" type="String" />
    <aura:attribute name="sObjectName" type="String" />
    <aura:attribute name="flowName" type="String" />
    <aura:attribute name="childToFlow" type="String" />
    <aura:attribute name="stageName" type="String" />
    <aura:attribute name="boolReFetchData" type="Boolean" default="false" />
    <aura:attribute name="insideRecordPage" type="Boolean" default="true" />
	<c:genericWizard recordId="{!v.recordId}" boolReFetchData="{!v.boolReFetchData}"
        flowName="{!v.flowName}" childToFlow="{!v.childToFlow}"
        insideRecordPage="{!v.insideRecordPage}" stageName="{!v.stageName}"></c:genericWizard>
</aura:component>