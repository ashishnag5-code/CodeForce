<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickActionWithoutHeader" access="global" >
    
    <!--c:ausf_rejectDocumentButtonLWC isShowModal="true"></c:ausf_rejectDocumentButtonLWC-->
    <aura:html tag="style">
        .slds-p-around–medium {
        padding: 0rem !important;
        }
        .slds-modal__content{
        overflow-y:hidden !important;
        height:unset !important;
        max-height:unset !important;
        overflow: initial !important;
        }
        .cuf-content {
        padding: 0 0rem !important;
        }
	</aura:html>
    <lightning:navigation aura:id="navigation"/>
    <c:ausf_RejectApplicationQuickActionV2 recordId="{!v.recordId}" onclosequickaction="{!c.handleExit}"></c:ausf_RejectApplicationQuickActionV2>
	
</aura:component>