<aura:component>
    <aura:attribute name="documentId" type="Id"/> 
    <aura:attribute name="theme" type="String"/>
    <aura:attribute name="pflName" type="String"/>
    <aura:attribute name="isDownload" type="Boolean" default="false"/>

    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />

    <div class="slds-align_absolute-center">
        <lightning:layout class="slds-align_absolute-center">
            <lightning:layoutItem padding="around-small" size="6">
                
                <div class="slds-form-element__row">
                    <div class="slds-form-element slds-size_1-of-1 slds-var-p-around_medium">
                        <img src="{!$Resource.pdfLogo}" width="100%" height="100%" class="slds-size_x-large"/>
                    </div>
                </div>
                <br/>

                <div class="slds-grid slds-grid_align-spread">
                    <div class="slds-col slds-form-element slds-size_1-of-2 slds-var-p-around_small">
                        <lightning:buttonIcon iconName="utility:preview" onclick="{! c.handlePreview }" variant="brand" alternativeText="View" title="View" class="buttonColor slds-size_medium"/>
                    </div>
                    <div class="slds-col slds-form-element slds-size_1-of-2 slds-var-p-around_small">
                        <aura:if isTrue="{!v.isDownload}">
                            <lightning:buttonIcon iconName="utility:download" onclick="{! c.handleDownload }" variant="brand" alternativeText="Download" title="Download" class="buttonColor slds-size_medium"/>
                        </aura:if>
                    </div>
                </div>                        

            </lightning:layoutItem>
            
        </lightning:layout>
    </div>    
</aura:component>