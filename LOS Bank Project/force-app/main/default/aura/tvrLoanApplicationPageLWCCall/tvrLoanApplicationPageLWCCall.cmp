<aura:component  access="global" implements="force:lightningQuickActionWithoutHeader,force:hasRecordId,flexipage:availableForAllPageTypes">
    <aura:attribute name="userId" type="String" />
    <aura:handler name="init" value="{!this}" action="{!c.init}" />
      <aura:html tag="style">             
        .slds-modal__container{        
        width: 100% !important;
        max-width: 70rem !important;
        }        
    </aura:html>

    <c:tvrLoanApplicationPage oncancel="{!c.cancel}"  recordId="{!v.recordId}"></c:tvrLoanApplicationPage>
</aura:component>