              <td class="noBorderCSS">Test</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div style = "margin-bottom: 2%"> 
        <div style = "margin-bottom:1%" class = "textCSS">
          Dear Yash Shukla,<br/>
        </div>
        <div style = "margin-bottom:1%" class = "textCSS"> 
          We are pleased to share that your Loan Application No. 123456, applied through AU WHEELS, has been principally sanctioned.<br/>
        </div>
        <div class = "textCSS"> 
          Here are the details
        </div>
      </div>

      <div class = "detailsTableCSS">
        <table>
          <thead>
            <tr>
              <th></th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Dealer Name</td>
