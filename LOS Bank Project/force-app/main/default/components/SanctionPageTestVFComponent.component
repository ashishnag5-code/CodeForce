            </tr>
            <tr>
              <td>Effective ROI (%)</td>
              <td>Dealer Name</td>
            </tr>
            <tr>
              <td>Interest Rate Type</td>
              <td>Dealer Name</td>
            </tr>
            <tr>
              <td>Benchmark Rate</td>
              <td>Dealer Name</td>
            </tr>
            <tr>
              <td>Benchmark Rate</td>
              <td>Dealer Name</td>
            </tr>
            <tr>
              <td class = "noBorderCSS">Maximum Interest</td>
              <td class = "noBorderCSS">Dealer Name</td>
            </tr>
          </tbody>
        </table>
