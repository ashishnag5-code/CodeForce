            </tr>
            <tr>
              <td>Vehicle No.(Only for old vehicles)</td>
              <td>Dealer Name</td>
            </tr>
            <tr>
              <td>Loan Amount</td>
              <td>Dealer Name</td>
            </tr>
            <tr>
              <td>Tenure</td>
              <td>Dealer Name</td>
            </tr>
            <tr>
              <td class = "noBorderCSS">EMI</td>
              <td class = "noBorderCSS">Dealer Name</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class = "detailsTableCSS" style="margin-bottom : 12% !important">
        <table>
          <thead>
            <tr>
              <th></th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Ex Showroom value</td>
              <td>Dealer Name</td>
            </tr>
            <tr>
              <td>Discount</td>
              <td>Dealer Name</td>
            </tr>
            <tr>
              <td>Loan Amount</td>
              <td>Dealer Name</td>
            </tr>
            <tr>
              <td>Deductions</td>
              <td>Dealer Name</td>
            </tr>
            <tr>
              <td>Final Amount</td>
              <td>Dealer Name</td>
            </tr>
            <tr>
              <td>LTV (%)</td>
