    <apex:attribute name="fromDate" type="String" description="The emi start date" />
    <apex:attribute name="customerName" type="String" description="The customer name" />
    <apex:attribute name="today" type="String" description="Today" />
    <apex:attribute name="referenceOne" type="String" description="Reference name" />
    <apex:attribute name="referenceTwo" type="String" description="Reference name" />
    <apex:attribute name="ifscList" type="String[]" description="IFSC" />
