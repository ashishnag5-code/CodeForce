                                    <div style="vertical-align: top;">&nbsp;<apex:image value="{!$Resource.tick_check_mark}" styleClass="checkbox" rendered="{!loanObj.Repayment_Account_Type__c='SB'}"/>&nbsp;<apex:image value="{!$Resource.tick_check_mark}" styleClass="checkbox" style="padding-left:22px;" rendered="{!loanObj.Repayment_Account_Type__c='CA'}"/></div>
                                    <b>&nbsp;SB / CA / CC / SB-NRE / SB- NRO / OTHER</b>
                                </span>
                            </td>
                        </span>

