                        </span>
                        <span>
                            <apex:image value="{!$Resource.checkbox_checked}" styleClass="checkbox"/>&nbsp;&nbsp;<b>Maximum</b>
                        </span>
                        </td>
                        <td class="noBorder" style="width:70%">
                        <span>
