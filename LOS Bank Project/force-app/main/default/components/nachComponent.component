                    <td class="noBorder" style="width:25%;text-align:right;"><b>I/We hereby authorise&nbsp;</b></td>
                    <td class="center" style="width:25%;text-align:center;">
                        <span style="font-size:10px;">
                            <b>AU Small Finance Bank Ltd.</b>
                        </span>
                    </td>
                </tr>
            </table>
            <table class="mandate-info-align">
                <tr>
                    <td class="noBorder" style="width:14%;text-align:left;">
