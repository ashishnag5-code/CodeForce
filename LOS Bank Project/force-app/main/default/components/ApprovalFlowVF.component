<apex:component controller="CAMReportChildComponentsController">
    <apex:attribute name="loanAppApproverRecordDetails" description="This is the value for the component."
                    type="Loan_Application_Approval__c[]" required="true" assignTo="{!loanAppApprovalRecords}"/>
    <apex:attribute name="productDetailsValue" description="This is the value for the component."
                    type="String" required="true" assignTo="{!productDetails}"/>
    <apex:attribute name="loanApp" description="This is the value for the component."
                    type="Loan_Application__c" required="true" assignTo="{!loan}"/>
    <apex:attribute name="collateralDetails" description="This is the value for the component."
                    type="Collateral__c" required="true" assignTo="{!collateral}"/>
    
    <div style='{!pageBlockSectionCSS}'>
        <apex:pageBlockSection showHeader="true" columns="1" title="Approval Flow">
            <!-- Added the code under pageBlockSection - R2 2067 -->
            <apex:pageBlockSectionItem >
                <apex:outputPanel >
                    <table style="{!tableStyle}">
                        <tr style="{!tableRowStyle}">
                            <th style="{!tableHeadDataStyle} width:5%;">Decision</th>
                            <th style="{!tableHeadDataStyle} width:10%;">Remarks</th>
                            <th style="{!tableHeadDataStyle} width:10%;">Username + ID</th>
                            <th style="{!tableHeadDataStyle} width:15%;">Loan Details</th>
                            <th style="{!tableHeadDataStyle} width:5%;">Start Date + Time</th>
                            <th style="{!tableHeadDataStyle} width:5%;">End Date + Time</th>
                            <th style="{!tableHeadDataStyle} width:5%;">Work step Name/level</th>
                        </tr>
                        <apex:repeat value="{!loanAppApprovalRecords}" var="approvalRecord">
                            <tr style="{!tableRowStyle}">
                                <td style="{!tableDataStyle}">{!approvalRecord.Approval_Status__c}</td>
                                <td style="{!tableDataStyle}">{!approvalRecord.Remarks__c}</td>
                                <td style="{!tableDataStyle}">{!approvalRecord.Approver__r.Name} {!approvalRecord.Approver__r.Employee_Code__c} 
                                    <!--<br/> {!LEFT(approvalRecord.Approver__r.Username,(FIND('@', approvalRecord.Approver__r.Username)-1))}--></td>
                                <!-- SFAU-5131 -->
                                
                                <td style="{!tableDataStyle}">
                                    <apex:outputPanel rendered="{!approvalRecord.Loan_Details__c <> ''}">
                                        {!approvalRecord.Loan_Details__c}
                                    </apex:outputPanel>
                                    <apex:outputPanel rendered="{!approvalRecord.Loan_Details__c == ''}">
                                        {!ROUND(loan.Loan_Amount__c, 0)} / {!ROUND(loan.Tenure__c, 0)} months / {!ROUND(loan.ROI__c, 2)} % / {!ROUND(collateral.LTV_offered_On_road__c,2)} %
                                    </apex:outputPanel>
                                </td>
                                <!-- <td style="{!tableDataStyle}">{!ROUND(loan.Loan_Amount__c, 0)} / {!ROUND(loan.Tenure__c, 0)} months / {!ROUND(loan.ROI__c, 2)} % / {!ROUND(collateral.LTV_offered_On_road__c,2)} %</td> -->
                                <td style="{!tableDataStyle}">
                                    <apex:outputField value="{!approvalRecord.LastModifiedDate}"></apex:outputField>
                                    <!--<apex:outputText value="{0,date,yyyy-MM-dd}">
                                    <apex:param value="{!approvalRecord.LastModifiedDate}" />
                                    </apex:outputText>-->
                                </td>
                                <td style="{!tableDataStyle}">
                                    <apex:outputField value="{!approvalRecord.Decision_Date_Time__c}"></apex:outputField>
                                    <!--<apex:outputText value="{0,date,yyyy-MM-dd}">
                                    <apex:param value="{!approvalRecord.Decision_Date_Time__c}" />
                                    </apex:outputText>-->
                                </td>
                                <td style="{!tableDataStyle}">{!approvalRecord.Approver_Level__c} {!approvalRecord.Deviation_Level__c}</td>
                            </tr>
                        </apex:repeat>
                    </table>
                </apex:outputPanel>
            </apex:pageBlockSectionItem>
        </apex:pageBlockSection>        
    </div>        
</apex:component>