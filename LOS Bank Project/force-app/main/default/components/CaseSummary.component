                    <script>
                        function creditVerify(loanId,stage,userProfile){
                            if(stage=='Credit' && userProfile=='Credit Manager'){//4733
                                Visualforce.remoting.Manager.invokeAction(
                                '{!$RemoteAction.CAMReportChildComponentsController.updateCreditVerification}',
                                    loanId.toString(),'Risk Score Sheet',
                                    function(result, event){
                                        if(event.status){
                                            var element1 = document.querySelectorAll('[id*="VerifyRiskForCredit"]');
                                            element1[0].innerHTML='Verified'
                                            element1[0].onclick=null
                                            element1[0].style.color='Green' 
                                        }
                                    }, 
                                    {escape: true}
                                );
                                
                            }
                        }
                        </script>
                    </apex:commandLink>

