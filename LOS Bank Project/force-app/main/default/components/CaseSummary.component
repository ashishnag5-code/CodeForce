                    <apex:outputText value="Verified" style="color:green;" rendered="{!IF(riskScoreVerified==true,true,false)}"></apex:outputText>

                    <apex:commandLink rendered="{!IF(riskScoreVerified==true || !(loan.Stage__c=='Credit' && currentUser.Profile.Name=='Credit Manager'),false,true)}" onclick="creditVerify('{!loan.Id}','{!loan.Stage__c}','{!currentUser.Profile.Name}'); return false;" value="Verify" id="VerifyRiskForCredit">

                    <script type="text/javascript">
                        function creditVerify(loanId,stage,userProfile){
                            if(stage=='Credit' && userProfile=='Credit Manager'){//4733
                                Visualforce.remoting.Manager.invokeAction(
                                '{!$RemoteAction.CAMReportChildComponentsController.updateCreditVerification}',
                                    loanId.toString(),'Risk Score Sheet',
                                    function(result, event){
                                        if(event.status){
                                            var element1 = document.querySelectorAll('[id*="VerifyRiskForCredit"]');
                                            element1[0].innerHTML='Verified'
                                            element1[0].onclick=null
                                            element1[0].style.color='Green' 
                                        }
                                    }, 
                                    {escape: true}
                                );
                            }
                                
                               
                            }
                        </script>
                    </apex:commandLink>
                </apex:form>
