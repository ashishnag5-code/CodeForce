<apex:component >
    <apex:attribute name="documents" description="DocCheckList Record for displaying applicant info" type="DocumentChecklistWrapper[]" required="true"/>

    <apex:repeat value="{!documents}" var="eachDocWrapper">
        <table cellspacing="2" cellpadding="2" width="100%">
            <tr style="background-color: white;text-align:center" width="100%"><th colspan="3">Documents</th></tr>
            <apex:repeat value="{!eachDocWrapper.documentNames}" var="eachColumn">
                <tr style="background-color: white">
                    <apex:repeat value="{!eachColumn}" var="eachDoc">
                        <td width="33%" style="padding-left:5px">{!eachDoc}</td>
                    </apex:repeat>
                </tr>
            </apex:repeat>
        </table><br/><br/>
    </apex:repeat>
</apex:component>