<apex:component controller="CAMReportChildComponentsController">
    <apex:attribute name="itrValidationSummary" description="This is the value for the component."
    type="Applicant_Financials_Details__c[]" required="true" assignTo="{!documentedWithOutAuditedFinancial}"/>
    
    <div style='{!pageBlockSectionCSS}'>
        <apex:pageBlockSection showHeader="true" title="ITR Validation Summary">							
        </apex:pageBlockSection>
        <table style="{!tableStyle}">
            <tr style="{!tableRowStyle}">
                <th style="{!tableHeadDataStyle} width:3% !important">Customer Name</th>
                <th style="{!tableHeadDataStyle} width:10% !important">Relationship with Applicant</th>
                <th style="{!tableHeadDataStyle} width:5% !important">AY</th>
                <th style="{!tableHeadDataStyle} width:10% !important">Gross total. Income</th>
                <th style="{!tableHeadDataStyle} width:10% !important">ITR Filling Date</th>
            </tr>
            <apex:repeat value="{!documentedWithOutAuditedFinancial}" var="itrFin">
                <tr style="{!tableRowStyle}">
                    <td style="{!tableDataStyle}">{!itrFin.Applicant__r.Applicant_Name__c}</td>
                    <td style="{!tableDataStyle}">{!itrFin.Applicant__r.Relationship_with_applicant__c}</td>
                    <td style="{!tableDataStyle}">{!itrFin.Year__c}</td>
                    <td style="{!tableDataStyle}">{!itrFin.Annual_Net_Profit__c}</td>
                    <td style="{!tableDataStyle}">
                        <apex:outputText value="{0,date,dd.MM.yyyy}">
                            <apex:param value="{!itrFin.Filing_Date__c}" />
                        </apex:outputText>
                    </td>
                </tr>
            </apex:repeat>
        </table>
    </div>   
</apex:component>