                                    <apex:image styleclass="checkBoxStyles" url="{!URLFOR($Resource.ApplicationForm, 'checkBox.png')}"/>
                                </apex:outputPanel>
                                <apex:outputText value="Sikh"/>
                            </apex:panelGrid>
                        </td>
                        <td width="8%">
                            <apex:panelGrid columns="2">
                                <apex:outputPanel rendered="{!applicant.Religion__c <> 'CHRISTIAN'}">
                                    <div class="whiteUncheckedBox"></div>
                                </apex:outputPanel>
                                <apex:outputPanel rendered="{!applicant.Religion__c == 'CHRISTIAN'}">
                                    <apex:image styleclass="checkBoxStyles" url="{!URLFOR($Resource.ApplicationForm, 'checkBox.png')}"/>
                                </apex:outputPanel>
                                <apex:outputText value="Christian"/>
                            </apex:panelGrid>
                        </td>
                        <td width="8%">
                            <apex:panelGrid columns="2">
                                <apex:outputPanel rendered="{!applicant.Religion__c <> 'JAIN'}">
                                    <div class="whiteUncheckedBox"></div>
                                </apex:outputPanel>
                                <apex:outputPanel rendered="{!applicant.Religion__c == 'JAIN'}">
                                    <apex:image styleclass="checkBoxStyles" url="{!URLFOR($Resource.ApplicationForm, 'checkBox.png')}"/>
                                </apex:outputPanel>
                                <apex:outputText value="Jain"/>
                            </apex:panelGrid>
                        </td>
                        <td width="8%">
                            <apex:panelGrid columns="2">
                                <apex:outputPanel rendered="{!applicant.Religion__c <> 'BUDDHIST'}">
                                    <div class="whiteUncheckedBox"></div>
                                </apex:outputPanel>
                                <apex:outputPanel rendered="{!applicant.Religion__c == 'BUDDHIST'}">
                                    <apex:image styleclass="checkBoxStyles" url="{!URLFOR($Resource.ApplicationForm, 'checkBox.png')}"/>
                                </apex:outputPanel>
                                <apex:outputText value="Buddhist"/>
                            </apex:panelGrid>
                        </td>
                        <td width="8%">
                            <apex:panelGrid columns="2">
                                <apex:outputPanel rendered="{!applicant.Religion__c <> 'ZOROASTRIAN'}">
                                    <div class="whiteUncheckedBox"></div>
                                </apex:outputPanel>
                                <apex:outputPanel rendered="{!applicant.Religion__c == 'ZOROASTRIAN'}">
                                    <apex:image styleclass="checkBoxStyles" url="{!URLFOR($Resource.ApplicationForm, 'checkBox.png')}"/>
                                </apex:outputPanel>
                                <apex:outputText value="Zorastrian"/>
                            </apex:panelGrid>
                        </td>
                        <td width="20%">
                            <apex:panelGrid columns="2">
                                <div class="whiteUncheckedBox"></div>
                                <apex:outputText value="Others _______________"/>
                            </apex:panelGrid>
                        </td>
                        <td><apex:outputText value="Gender"/></td>
                        <td>
                            <apex:outputPanel rendered="{!applicant.Gender__c == 'Male'}">
                                <div class="whiteUncheckedBox" style="color:black;text-align:center">M</div>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!applicant.Gender__c <> 'Male'}">
                                <div class="whiteUncheckedBox" style="color:#a89f9e;text-align:center">M</div>
                            </apex:outputPanel>
                        </td>
                        <td>
                            <apex:outputPanel rendered="{!applicant.Gender__c == 'Female'}">
                                <div class="whiteUncheckedBox" style="color:black;text-align:center">F</div>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!applicant.Gender__c <> 'Female'}">
                                <div class="whiteUncheckedBox" style="color:#a89f9e;text-align:center">F</div>
                            </apex:outputPanel>
                        </td>
                        <td>
                            <apex:outputPanel rendered="{!applicant.Gender__c == 'Transgender'}">
                                <div class="whiteUncheckedBox" style="color:black;text-align:center">T</div>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!applicant.Gender__c <> 'Transgender'}">
                                <div class="whiteUncheckedBox" style="color:#a89f9e;text-align:center">T</div>
                            </apex:outputPanel>
                        </td>
                        <td><apex:outputText value="^  ^Third Gender"/></td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <th>Category</th>
            <td>
                <table width="100%">
                    <tr width="100%">
                        <td width="8%">
                            <apex:panelGrid columns="2">
                                <apex:outputPanel rendered="{!applicant.Caste__c <> 'GENERAL'}">
                                    <div class="whiteUncheckedBox"></div>
                                </apex:outputPanel>
                                <apex:outputPanel rendered="{!applicant.Caste__c == 'GENERAL'}">
                                    <apex:image styleclass="checkBoxStyles" url="{!URLFOR($Resource.ApplicationForm, 'checkBox.png')}"/>
                                </apex:outputPanel>
                                <apex:outputText value="General"/>
                            </apex:panelGrid>
                        </td>
                        <td width="8%">
                            <apex:panelGrid columns="2">
                                <apex:outputPanel rendered="{!applicant.Caste__c <> 'SC'}">
                                    <div class="whiteUncheckedBox"></div>
                                </apex:outputPanel>
                                <apex:outputPanel rendered="{!applicant.Caste__c == 'SC'}">
                                    <apex:image styleclass="checkBoxStyles" url="{!URLFOR($Resource.ApplicationForm, 'checkBox.png')}"/>
                                </apex:outputPanel>
                                <apex:outputText value="SC"/>
                            </apex:panelGrid>
                        </td>
                        <td width="8%">
                            <apex:panelGrid columns="2">
                                <apex:outputPanel rendered="{!applicant.Caste__c <> 'ST'}">
                                    <div class="whiteUncheckedBox"></div>
                                </apex:outputPanel>
                                <apex:outputPanel rendered="{!applicant.Caste__c == 'ST'}">
                                    <apex:image styleclass="checkBoxStyles" url="{!URLFOR($Resource.ApplicationForm, 'checkBox.png')}"/>
                                </apex:outputPanel>
                                <apex:outputText value="ST"/>
                            </apex:panelGrid>
                        </td>
                        <td width="8%">
                            <apex:panelGrid columns="2">
                                <apex:outputPanel rendered="{!applicant.Caste__c <> 'OBC'}">
