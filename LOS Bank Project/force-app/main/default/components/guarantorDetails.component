                                </apex:outputPanel>
                                <apex:outputPanel rendered="{!applicant.Caste__c == 'OBC'}">
                                    <apex:image styleclass="checkBoxStyles" url="{!URLFOR($Resource.ApplicationForm, 'checkBox.png')}"/>
                                </apex:outputPanel>
                                <apex:outputText value="OBC"/>
