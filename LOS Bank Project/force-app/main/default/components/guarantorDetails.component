                                </apex:outputPanel>
                                <apex:outputPanel rendered="{!applicant.Caste__c <> 'MINORITY'}">
                                    <apex:outputText value="Others _________________"/>
                                </apex:outputPanel>
                                <apex:outputPanel rendered="{!applicant.Caste__c == 'MINORITY'}">
                                    <apex:outputText ><span>Others </span><span style="text-decoration: underline">{!applicant.Caste__c}</span></apex:outputText>
                                </apex:outputPanel>
                            </apex:panelGrid>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <th>Marital Status</th>
            <td>
                <table width="100%">
                    <tr width="100%">
                        <td width="8%">
                            <apex:panelGrid columns="2">
                                <apex:outputPanel rendered="{!applicant.Marital_Status__c <> 'Married'}">
                                    <div class="whiteUncheckedBox"></div>
                                </apex:outputPanel>
                                <apex:outputPanel rendered="{!applicant.Marital_Status__c == 'Married'}">
                                    <apex:image styleclass="checkBoxStyles" url="{!URLFOR($Resource.ApplicationForm, 'checkBox.png')}"/>
                                </apex:outputPanel>
                                <apex:outputText value="Married"/>
                            </apex:panelGrid>
                        </td>
