    <table width="100%">
        <tr width="100%">
            <th width="8%">PAN No.</th>
            <td style="background-color: white;padding:6px" width="12%">
                <apex:outputField value="{!applicant.PAN__c}"/>
            </td>
            <td><apex:outputText value="Form 60"/></td>
