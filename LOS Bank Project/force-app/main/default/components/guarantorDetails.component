                                            <apex:outputField value="{!applicant.Aadhaar_Number__c}"/>
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!entityProofMap[applicant.Id] == 'Voter ID'}">
                                            <apex:outputField value="{!applicant.Voter_Id__c}"/>
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!entityProofMap[applicant.Id] == 'National Population Register (NPR)'}">
                                            <apex:outputField value="{!applicant.NPR__c}"/>
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!entityProofMap[applicant.Id] == 'NREGA Job Card'}">
                                            <apex:outputField value="{!applicant.NREGA__c}"/>
                                        </apex:outputPanel>
                                    </td>
                                    <td style="text-align:right">Expiry Date</td>
                                    <td style="background-color: white;padding-left: 5px" width="20%">
                                        <apex:outputPanel rendered="{!entityProofMap[applicant.Id] == 'Passport'}">
                                            <apex:outputField value="{!applicant.Passport_Expiry_Date__c}"/>
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!entityProofMap[applicant.Id] == 'Driving License'}">
                                            <apex:outputField value="{!applicant.Driving_License_Expiry_Date__c}"/>
                                        </apex:outputPanel>
                                    </td>
                                    <td><apex:outputText >(If applicable)</apex:outputText></td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
                <table>
                    <tr width="100%">
                        <th width="8%" colspan="2">Proof of Address</th>
                        <td width="92%">
                            <table width="100%">
                                <tr width="100%">
                                    <td>
                                        <apex:panelGrid columns="2">
                                            <apex:outputPanel rendered="{!entityProofMap[applicant.Id] == 'Passport'}">
                                                <apex:image styleclass="checkBoxStyles" url="{!URLFOR($Resource.ApplicationForm, 'checkBox.png')}"/>
                                            </apex:outputPanel>
                                            <apex:outputPanel rendered="{!entityProofMap[applicant.Id] <> 'Passport'}">
                                                <div class="whiteUncheckedBox"></div>
                                            </apex:outputPanel>
                                            <apex:outputText value="Passport"/>
                                        </apex:panelGrid>
                                    </td>
                                    <td>
                                        <apex:panelGrid columns="2">
                                            <apex:outputPanel rendered="{!entityProofMap[applicant.Id] == 'Driving License'}">
                                                <apex:image styleclass="checkBoxStyles" url="{!URLFOR($Resource.ApplicationForm, 'checkBox.png')}"/>
                                            </apex:outputPanel>
                                            <apex:outputPanel rendered="{!entityProofMap[applicant.Id] <> 'Driving License'}">
                                                <div class="whiteUncheckedBox"></div>
                                            </apex:outputPanel>
                                            <apex:outputText value="Driving License"/>
                                        </apex:panelGrid>
                                    </td>
                                    <td>
                                        <apex:panelGrid columns="2">
                                            <apex:outputPanel rendered="{!entityProofMap[applicant.Id] == 'Aadhaar'}">
                                                <apex:image styleclass="checkBoxStyles" url="{!URLFOR($Resource.ApplicationForm, 'checkBox.png')}"/>
                                            </apex:outputPanel>
                                            <apex:outputPanel rendered="{!entityProofMap[applicant.Id] <> 'Aadhaar'}">
                                                <div class="whiteUncheckedBox"></div>
                                            </apex:outputPanel>
                                            <apex:outputText value="Aadhaar"/>
                                        </apex:panelGrid>
                                    </td>
                                    <td>
                                        <apex:panelGrid columns="2">
                                            <apex:outputPanel rendered="{!entityProofMap[applicant.Id] == 'Voter ID'}">
                                                <apex:image styleclass="checkBoxStyles" url="{!URLFOR($Resource.ApplicationForm, 'checkBox.png')}"/>
                                            </apex:outputPanel>
                                            <apex:outputPanel rendered="{!entityProofMap[applicant.Id] <> 'Voter ID'}">
                                                <div class="whiteUncheckedBox"></div>
                                            </apex:outputPanel>
                                            <apex:outputText value="Voter ID"/>
                                        </apex:panelGrid>
                                    </td>
                                    <td>
                                        <apex:panelGrid columns="2">
                                            <apex:outputPanel rendered="{!NOT(OR(entityProofMap[applicant.Id] == 'Aadhaar', entityProofMap[applicant.Id] == 'Voter ID', entityProofMap[applicant.Id] == 'Driving License', entityProofMap[applicant.Id] == 'Passport'))}">
                                                <apex:image styleclass="checkBoxStyles" url="{!URLFOR($Resource.ApplicationForm, 'checkBox.png')}"/>
                                            </apex:outputPanel>
                                            <apex:outputPanel rendered="{!NOT(OR(entityProofMap[applicant.Id] == 'Aadhaar', entityProofMap[applicant.Id] == 'Voter ID', entityProofMap[applicant.Id] == 'Driving License', entityProofMap[applicant.Id] == 'Passport'))}">
                                                <apex:outputText ><span>Others </span><span style="text-decoration: underline">{!entityProofMap[applicant.Id]}</span></apex:outputText>
                                            </apex:outputPanel>
                                            <apex:outputPanel rendered="{!OR(entityProofMap[applicant.Id] == 'Aadhaar', entityProofMap[applicant.Id] == 'Voter ID', entityProofMap[applicant.Id] == 'Driving License', entityProofMap[applicant.Id] == 'Passport')}">
                                                <div class="whiteUncheckedBox"></div>
                                            </apex:outputPanel>
                                            <apex:outputPanel rendered="{!OR(entityProofMap[applicant.Id] == 'Aadhaar', entityProofMap[applicant.Id] == 'Voter ID', entityProofMap[applicant.Id] == 'Driving License', entityProofMap[applicant.Id] == 'Passport')}">
                                                <apex:outputText value="Others ______________"/>
                                            </apex:outputPanel>
                                        </apex:panelGrid>
                                    </td>
                                </tr>
                            </table>
                        </td> 
                    </tr>
                </table>
            </td>
            <td width="1%" rowspan="13">
                <table cellspacing="8" width="100%">
                    <tr width="100%">
                        <td><apex:image style="float:right;" value="{!mapApplicantImage[applicant.Id]}" width="200px" height="200px"/></td>
                    </tr>
                    <tr width="100%" style="line-height:40px;background-color:white;">
                        <td width="100%" style="text-align: center;color:#a89f9e;"><br/>Signature of Guarantor</td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</apex:component>