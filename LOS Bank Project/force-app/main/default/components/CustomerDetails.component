                            <tr style="{!tableRowStyle}">
                                <td style="{!tableHeadStyle}" >Final Remarks</td>
                                <apex:repeat value="{!applicants}" var="applicant">
                                    <apex:repeat value="{!fieldInvestigationRecords}" var="fiRecord">
                                        <td style="{!tableDataStyle} display: {!IF(fiRecord.entity==applicant.RecordType.Name, 'table-cell', 'none')};" >
                                            <span style="text-align:center; color:black;" >{!fiRecord.finalStatus}</span>  
                                        </td> 
                                    </apex:repeat>
                                </apex:repeat>
                                <td style="{!tableDataStyle}  display:{!IF(applicants.size==1,'table-cell','none')}"></td>
                                <td style="{!tableDataStyle} display:{!IF(applicants.size==2 || applicants.size==1,'table-cell','none')}"></td>
                            </tr>
                        </table>
                    </div>
                </apex:outputPanel>
            </apex:pageBlockSectionItem>
        </apex:pageBlockSection>
    </div>  
</apex:component>