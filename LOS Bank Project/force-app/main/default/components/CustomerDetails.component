                            </tr>   
                            
                            
                            <tr style="{!tableRowStyle} display: {!IF(subProduct=='New', 'table-row', 'none')};">
                                <th style="{!tableHeadStyle}">Customer Profile</th>
                                <apex:repeat value="{!applicants}" var="applicant">
                                    <td style="{!tableDataStyle}">{!applicant.Type_Of_Employment__c}</td><!--{!applicant.Customer_Grade__c}-->
