<apex:component controller="CAMReportChildComponentsController">

    <apex:attribute name="loanApp" description="This is the value for the component."
    type="Loan_Application__c" required="true" assignTo="{!loan}"/>
    <apex:attribute name="exposureDetailsForAppBankRecords" description="This is the value for the component."
    type="Bank_Account_Records__c[]" required="true" assignTo="{!applicantExposure}"/>
    <apex:attribute name="applicantDetail" description="This is the value for the component."
    type="Applicant__c" required="true" assignTo="{!applicant}"/>
																			
    <div style='{!pageBlockSectionCSS}'>
        <apex:pageBlockSection showHeader="true" title="Exposure Details (Applicant as a Co-applicant / Guarantor)">
        </apex:pageBlockSection>
            <table style="{!tableStyle}">
                <tr style="{!tableRowStyle}">
                        <th style="{!tableHeadDataStyle} width:15% !important">Account Holder Name</th>
                        <th style="{!tableHeadDataStyle} width:15% !important">Prod Code + Name</th>
                        <th style="{!tableHeadDataStyle} width:15% !important">A/c No</th>
                        <th style="{!tableHeadDataStyle} width:10% !important">Relationship with said case</th>
                        <th style="{!tableHeadDataStyle} width:10% !important">Loan/limit Amount</th>
                        <th style="{!tableHeadDataStyle} width:10% !important">POS</th>
                        <th style="{!tableHeadDataStyle} width:10% !important">EMI Billed / Tenor</th>
                        <th style="{!tableHeadDataStyle} width:5% !important">No of EMI Overdue</th>
                        <th style="{!tableHeadDataStyle} width:10% !important">Overdue Amt</th>
                        <!--<th style="{!tableHeadDataStyle} width:10% !important">Average / Peak Delay (last 12 months)</th>-->
                        <th style="{!tableHeadDataStyle} width:7% !important">Average Delay (last 12 months)</th>
                        <th style="{!tableHeadDataStyle} width:7% !important"> Peak Delay (last 12 months)</th>
                        <th style="{!tableHeadDataStyle} width:5% !important">No. of Bouncing</th>                   
                </tr>
                <apex:repeat value="{!applicantExposure}" var="bankRec">
                    <tr style="{!tableRowStyle}">
                        <td style="{!tableDataStyle}">{!bankRec.Account_Name__c}</td>
                        <td style="{!tableDataStyle}">{!bankRec.Product__c} {!bankRec.Product_Code__c}</td>
                        <td style="{!tableDataStyle}">{!bankRec.Loan_Number__c}</td>
                        <td style="{!tableDataStyle}"></td>
                        <td style="{!tableDataStyle}">
                            <div style="display: {!IF(bankRec.Account_Type__c=='Loan', 'inline', 'none')};">
                                {!bankRec.Loan_Amount__c}
                            </div>
                            <div style="display: {!IF((bankRec.Account_Type__c=='CASA' || bankRec.Account_Type__c=='ODCC'), 'inline', 'none')};">
                                {!bankRec.OD_Limit_Sanctioned__c}
                            </div> 
                        </td>
                        <td style="{!tableDataStyle}">{!bankRec.POS__c}</td>
                        <td style="{!tableDataStyle}">{!bankRec.EMI_Amount__c} {!bankRec.Tenure__c}</td>
                        <td style="{!tableDataStyle}">{!bankRec.Loan_Overdue_EMI__c}</td>
                        <td style="{!tableDataStyle}">{!bankRec.InstallmentsOverDue__c}</td>
                        <td style="{!tableDataStyle}"></td>
                        <td style="{!tableDataStyle}"></td>
                        <td style="{!tableDataStyle}">{!bankRec.No_of_Bouncing__c}</td>
                    </tr>
                </apex:repeat>
                      
            </table>
    </div>         
</apex:component>