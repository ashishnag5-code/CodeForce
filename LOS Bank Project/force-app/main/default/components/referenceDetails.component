                        <td width="30%" style="border-bottom: 1px solid black;padding-left:5px">{!references[1].Relationship_With_Borrower}</td>
                        <!--td style="text-align: right">Years of acquaintance</td>
                        <td>
                            <apex:panelGrid columns="3">
                                <div class="whiteUncheckedBox"></div>
                                <apex:outputText >&nbsp;</apex:outputText>
                                <div class="whiteUncheckedBox"></div>
                            </apex:panelGrid>
                        </td-->
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</apex:component>