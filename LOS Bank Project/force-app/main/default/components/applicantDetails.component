<apex:component >
    <apex:attribute name="loan" description="Loan Record for displaying loan info" type="Loan_Application__c" required="true"/>
    <apex:attribute name="applicant" description="Applicant Record for displaying applicant info" type="Applicant__c" required="true"/>
    <apex:attribute name="currentAddress" description="Current Address records of the applicant" type="Address__c"/>
    <apex:attribute name="permanentAddress" description="Permanent Address records of the applicant" type="Address__c"/>
    <apex:attribute name="applicantFinancial" description="Applicant Financial Details" type="Applicant_Financials_Details__c"/>
    <apex:attribute name="applicantPhoto" description="Applicant Photo for displaying applicant info" type="String" required="false"/>
    <apex:attribute name="annualIncome" description="Income of the applicant" type="String" required="false"/>
    <apex:attribute name="workExperienceMap" description="Work Experience Details of the applicant" type="Map" required="false"/>
    <apex:attribute name="officeAddress" description="Office Address records of the applicant" type="Address__c"/>
    <apex:attribute name="beneficialOwners" description="Beneficial Owners of non-individual applicant" type="Applicant__c[]"/>
    <apex:attribute name="entityProofMap" description="ID/Address Proof details of applicants" type="map" required="false"/>

    <!-- PRIMARY APPLICANT DETAILS SECTION STARTS HERE -->
    <apex:outputPanel rendered="{!applicant.RecordType.DeveloperName == 'Primary_Applicant'}">
        <p class="subHeadingStyles">A. APPLICANT DETAILS (Leave space between two words)</p>
    </apex:outputPanel>
    <apex:outputPanel rendered="{!applicant.RecordType.DeveloperName == 'Co_Applicant'}">
        <p class="subHeadingStyles">B. CO-APPLICANT DETAILS (Leave space between two words)</p>
    </apex:outputPanel>
    <apex:outputPanel rendered="{!applicant.RecordType.DeveloperName == 'Guarantor'}">
        <p class="subHeadingStyles">C. GUARANTOR DETAILS (Leave space between two words)</p>
    </apex:outputPanel>
    <table width="100%">
        <tr width="100%">
            <th width="12%">Existing Customer</th>
            <td width="88%">
                <table width="100%">
                    <tr width="100%">
                        <td>
                            <apex:panelGrid columns="4">
                                <apex:outputPanel rendered="{!applicant.Existing_Customer__c == 'Yes'}">
                                    <apex:image styleclass="checkBoxStyles" url="{!URLFOR($Resource.ApplicationForm, 'checkBox.png')}"/>
                                </apex:outputPanel>
                                <apex:outputPanel rendered="{!applicant.Existing_Customer__c <> 'Yes'}">
                                    <div class="whiteUncheckedBox"></div>
                                </apex:outputPanel>
                                <apex:outputText value="Yes"/>
                                <apex:outputPanel rendered="{!applicant.Existing_Customer__c <> 'Yes'}">
                                    <apex:image styleclass="checkBoxStyles" url="{!URLFOR($Resource.ApplicationForm, 'checkBox.png')}"/>
                                </apex:outputPanel>
                                <apex:outputPanel rendered="{!applicant.Existing_Customer__c == 'Yes'}">
                                    <div class="whiteUncheckedBox"></div>
                                </apex:outputPanel>
                                <apex:outputText value="No"/>
                            </apex:panelGrid>
                        </td>
                        <td width="2%"/>
                        <td><apex:outputText value="Account No./CIF No."/></td>
                        <td style="background-color: white;padding-left:5px" width="30%"><apex:outputField value="{!applicant.CIF_No__c}"/></td>
                        <td width="2%"/>
                        <td width="8%"><apex:outputText value="CKYCR No."/></td>
                        <td style="background-color: white;padding-left:5px" width="30%"><apex:outputField value="{!applicant.CKYC__c}"/></td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <th>Constitution</th>
            <td>
                <table width="100%">
                    <tr width="100%">
                        <td>
                            <apex:panelGrid columns="2">
                                <apex:outputPanel rendered="{!applicant.Customer_Type__c == 'Individual'}">
                                    <apex:image styleclass="checkBoxStyles" url="{!URLFOR($Resource.ApplicationForm, 'checkBox.png')}"/>
                                </apex:outputPanel>
                                <apex:outputPanel rendered="{!applicant.Customer_Type__c <> 'Individual'}">
                                    <div class="whiteUncheckedBox"></div>
                                </apex:outputPanel>
                                <apex:outputText value="Individual"/>
                            </apex:panelGrid>
                        </td>
                        <td>
                            <apex:panelGrid columns="2">
                                <apex:outputPanel rendered="{!applicant.Constitution_Type__c == 'Sole Proprietary'}">
                                    <apex:image styleclass="checkBoxStyles" url="{!URLFOR($Resource.ApplicationForm, 'checkBox.png')}"/>
                                </apex:outputPanel>
                                <apex:outputPanel rendered="{!applicant.Constitution_Type__c <> 'Sole Proprietary'}">
                                    <div class="whiteUncheckedBox"></div>
                                </apex:outputPanel>
                                <apex:outputText value="Proprietorship"/>
                            </apex:panelGrid>
                        </td>
                        <td>
                            <apex:panelGrid columns="2">
                                <apex:outputPanel rendered="{!applicant.Constitution_Type__c == 'Partnership Firms'}">
                                    <apex:image styleclass="checkBoxStyles" url="{!URLFOR($Resource.ApplicationForm, 'checkBox.png')}"/>
                                </apex:outputPanel>
                                <apex:outputPanel rendered="{!applicant.Constitution_Type__c <> 'Partnership Firms'}">
                                    <div class="whiteUncheckedBox"></div>
                                </apex:outputPanel>
                                <apex:outputText value="Partnership Firm"/>
                            </apex:panelGrid>
                        </td>
                        <td>
                            <apex:panelGrid columns="2">
                                <apex:outputPanel rendered="{!applicant.Constitution_Type__c == 'Private Limited'}">
                                    <apex:image styleclass="checkBoxStyles" url="{!URLFOR($Resource.ApplicationForm, 'checkBox.png')}"/>
                                </apex:outputPanel>
                                <apex:outputPanel rendered="{!applicant.Constitution_Type__c <> 'Private Limited'}">
                                    <div class="whiteUncheckedBox"></div>
                                </apex:outputPanel>
                                <apex:outputText value="Pvt. Ltd."/>
                            </apex:panelGrid>
                        </td>
                        <td>
                            <apex:panelGrid columns="2">
                                <apex:outputPanel rendered="{!applicant.Constitution_Type__c == 'Public Limited'}">
                                    <apex:image styleclass="checkBoxStyles" url="{!URLFOR($Resource.ApplicationForm, 'checkBox.png')}"/>
                                </apex:outputPanel>
                                <apex:outputPanel rendered="{!applicant.Constitution_Type__c <> 'Public Limited'}">
                                    <div class="whiteUncheckedBox"></div>
                                </apex:outputPanel>
                                <apex:outputText value="Public Ltd."/>
                            </apex:panelGrid>
                        </td>
                        <td>
                            <apex:panelGrid columns="2">
                                <apex:outputPanel rendered="{!OR(applicant.Constitution_Type__c == 'Trust', applicant.Constitution_Type__c == 'HUF', applicant.Constitution_Type__c == 'Society')}">
                                    <apex:image styleclass="checkBoxStyles" url="{!URLFOR($Resource.ApplicationForm, 'checkBox.png')}"/>
                                </apex:outputPanel>
                                <apex:outputPanel rendered="{!NOT(OR(applicant.Constitution_Type__c == 'Trust', applicant.Constitution_Type__c == 'HUF', applicant.Constitution_Type__c == 'Society'))}">
                                    <div class="whiteUncheckedBox"></div>
                                </apex:outputPanel>
                                <apex:outputPanel rendered="{!OR(applicant.Constitution_Type__c == 'Trust', applicant.Constitution_Type__c == 'HUF', applicant.Constitution_Type__c == 'Society')}">
                                    <apex:outputText ><span>Others </span><span style="text-decoration: underline">{!applicant.Constitution_Type__c}</span></apex:outputText>
                                </apex:outputPanel>
                                <apex:outputPanel rendered="{!NOT(OR(applicant.Constitution_Type__c == 'Trust', applicant.Constitution_Type__c == 'HUF', applicant.Constitution_Type__c == 'Society'))}">
                                    <apex:outputText >Others __________________________</apex:outputText>
                                </apex:outputPanel>
                            </apex:panelGrid>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <th rowspan="2">
                <apex:outputText value="Name"/>
                <apex:panelGrid columns="2" cellpadding="0" cellspacing="0">
                    <apex:outputPanel rendered="{!applicant.Gender__c <> 'Female'}">
                        <apex:image styleclass="checkBoxStyles" url="{!URLFOR($Resource.ApplicationForm, 'checkBox.png')}"/>
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!AND(applicant.Gender__c == 'Female', applicant.Marital_Status__c <> 'Married')}">
                        <apex:image styleclass="checkBoxStyles" url="{!URLFOR($Resource.ApplicationForm, 'checkBox.png')}"/>
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!AND(applicant.Gender__c == 'Female', applicant.Marital_Status__c == 'Married')}">
                        <div class="whiteUncheckedBox"></div>
                    </apex:outputPanel>
                    <apex:outputText value="Father's Name OR"/>
                </apex:panelGrid>
                <apex:panelGrid columns="2" cellpadding="0" cellspacing="0">
                    <apex:outputPanel rendered="{!AND(applicant.Gender__c == 'Female', applicant.Marital_Status__c <> 'Married')}">
                        <div class="whiteUncheckedBox"></div>
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!AND(applicant.Gender__c == 'Female', applicant.Marital_Status__c == 'Married')}">
                        <apex:image styleclass="checkBoxStyles" url="{!URLFOR($Resource.ApplicationForm, 'checkBox.png')}"/>
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!applicant.Gender__c == 'Male'}">
                        <div class="whiteUncheckedBox"></div>
                    </apex:outputPanel>
                    <apex:outputText value="Spouse Name"/>
                </apex:panelGrid>
            </th>
            <td>
                <table width="100%">
                    <tr style="background-color:white" width="100%">
                        <td style="background-color: white;padding:5px" width="100%">
                            <apex:outputField value="{!applicant.Title__c}"/>&nbsp;<apex:outputField value="{!applicant.Applicant_Name__c}"/>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <td>
                <table width="100%">
                    <tr style="background-color:white" width="100%">
                        <td style="background-color: white;padding:5px" width="100%">
                            <apex:outputPanel rendered="{!applicant.Gender__c <> 'Female'}">
                                <apex:outputField value="{!applicant.Father_Name__c}"/>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!AND(applicant.Gender__c == 'Female', applicant.Marital_Status__c <> 'Married')}">
                                <apex:outputField value="{!applicant.Father_Name__c}"/>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!AND(applicant.Gender__c == 'Female', applicant.Marital_Status__c == 'Married')}">
                                <apex:outputField value="{!applicant.Spouse_Name__c}"/>
                            </apex:outputPanel>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <th>Mother&apos;s Name</th>
            <td>
                <table width="100%">
                    <tr style="background-color:white" width="100%">
